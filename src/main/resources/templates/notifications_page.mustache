<!DOCTYPE html>
<html lang="en">
{{> fragments/html_header}}
<body>
    {{> fragments/top_bar}}
    <main class="container">
        <h2>Notifications</h2>
        <form action="/notifications" method="get" class="notification-filters">
            <label>Activity
                <select name="type" class="short-input">
                    <option value="">All activity</option>
                    {{#typeOptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>
                    {{/typeOptions}}
                </select>
            </label>
            <label><input type="checkbox" name="unread" value="true" {{#unreadOnly}}checked{{/unreadOnly}}> Unread only</label>
            <button type="submit" class="action-button">Filter</button>
        </form>
        {{#hasUnreadNotifications}}
        <form action="/notifications/read-all" method="post" class="notification-read-all">
            <button type="submit" class="action-button">Mark all as read</button>
        </form>
        {{/hasUnreadNotifications}}
        {{#notificationsLoaded}}
        {{#notifications}}
            <article class="post framed notification {{^isRead}}notification-unread{{/isRead}}">
                <img src="{{actor.profileImagePath}}" alt="Profile picture">
                <div class="post-body">
                    <a href="/profile/{{actor.userId}}">{{actor.firstName}} {{actor.lastName}}</a>
                    {{#isLike}}liked your post.{{/isLike}}
                    {{#isComment}}commented on your post.{{/isComment}}
                    {{#isFollow}}started following you.{{/isFollow}}
                    {{#isMention}}mentioned you in a post.{{/isMention}}
                    <div class="post-date">{{createdAt}}</div>
                    {{^isRead}}<span class="notification-status">Unread</span>{{/isRead}}
                    <div class="notification-actions">
                        {{#targetUrl}}
                        <a href="{{targetUrl}}">{{#isFollow}}View profile{{/isFollow}}{{^isFollow}}View post{{/isFollow}}</a>
                        {{/targetUrl}}
                        {{^targetUrl}}<span>Post no longer available.</span>{{/targetUrl}}
                        {{^isRead}}
                        <form action="/notifications/{{id}}/read" method="post">
                            <button type="submit" class="action-button">Mark as read</button>
                        </form>
                        {{/isRead}}
                    </div>
                </div>
            </article>
        {{/notifications}}
        {{^notifications}}
            <p>No notifications match these filters.</p>
        {{/notifications}}
        {{/notificationsLoaded}}
    </main>
    {{> fragments/footer}}
</body>
</html>
